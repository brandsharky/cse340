<%- include('partials/header') %>
<main>
  <div class="titles">
    <h1><%= title %></h1>
  </div>

  <div class="category-details">
    <h2>Service Projects</h2>

    <ul class="projects-by-category">
      <% projects.forEach(project => { %>
        <li><a href="/project/<%= project.project_id %>"><%= project.title %></a></li>
      <% }); %>
    </ul>
  </div>

  <a href="/edit-category/<%= categoryDetails.category_id %>">Edit Category</a>
</main>
<%- include('partials/footer') %>