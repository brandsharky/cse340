<%- include('partials/header') %>
<main>
  <div class="titles">
    <h1><%= name %>'s <%= title %></h1>
  </div>

  <div class="dashboard">
    <p>Name: <span><%= name %></span></p>
    <p>Username: <span><%= email %></span></p>
  </div>

  <% if (user && user.role_name === 'admin') { %>
    <a href="/users">Registered Users</a>
  <% } %>
</main>
<%- include('partials/footer') %>