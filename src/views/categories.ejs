<%- include('partials/header') %>
<main>
  <div class="titles">
    <h1><%= title %></h1>

    <p>Here are some of our service project categories:</p>
  </div>

  <ul class="categories">
    <% categories.forEach(category => { %>
      <li><a href="/category/<%= category.category_id %>"><%= category.name %></a></li>
    <% }); %>
  </ul>

  <a href="/new-category">+ Add New Category</a>
</main>
<%- include('partials/footer') %>