<%- include('partials/header') %>
<main>
  <div class="titles">
    <h1><%= title %></h1>
    <h2><%= organizationDetails.name %></h2>
  </div>

  <div class="organization-details">
    <img src="/images/<%= organizationDetails.logo_filename %>" alt="<%= organizationDetails.name %> logo" class="organization-logo">
    <p><%= organizationDetails.description %></p>
  </div>

  <div class="organization-projects">
    <h3>Service Projects</h3>
    <ul class="projects-by-organization">
      <% projects.forEach(project => { %>
        <li><a href="/project/<%= project.project_id %>"><%= project.title %></a></li>
      <% }); %>
    </ul>
  </div>

  <% if (user && user.role_name === 'admin') { %>
    <a href="/edit-organization/<%= organizationDetails.organization_id %>">Edit Organization</a>
  <% } %>
</main>
<%- include('partials/footer') %>