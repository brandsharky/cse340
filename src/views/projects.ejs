<%- include('partials/header') %>
<main>
  <div class="titles">
    <h1><%= title %></h1>
  </div>

  <ul class="projects">
    <% projects.forEach(project => { %>
      <li class="project-card">
        <a href="/project/<%= project.project_id %>" class="project-link">

          <span class="project-date">
            <%= new Date(project.project_date).toLocaleDateString('en-US', {
              year: 'numeric',
              month: 'long',
              day: 'numeric'
            }) %>
          </span>

          <h2 class="project-title"><%= project.title %></h2>

          <p class="project-org"><%= project.organization_name %></p>

          <p class="project-description"><%= project.description %></p>
        </a>

        <a href="/organization/<%= project.organization_id %>" class="organization-button">View Organization</a>
      </li>
    <% }); %>
  </ul>

  <% if (user && user.role_name === 'admin') { %>
    <a href="/new-project">+ Add New Service Project</a>
  <% } %>
</main>
<%- include('partials/footer') %>